{
  "expo": {
    "name": "Reporta YA!",
    "slug": "reporta-ya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-reportaya.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-reportaya.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.reportaya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-reportaya.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/logo-reportaya.png"
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "f7d2330b-e3b6-47ac-9e39-df4386e5d70e"
      }
    },
    "owner": "ju4mpizel"
  }
}
